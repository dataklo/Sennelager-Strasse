# Oeffentliche Adresse ohne abschliessenden Slash
PUBLIC_BASE_URL=https://example.de

# Ziel-URL: ftps://...:21/pfad oder sftp://...:22/pfad
FTP_URL=ftps://wwwXXX.your-server.de:21/public_html

# Hetzner-Zugangsdaten (im konsoleH-Webhostingbereich zu finden)
FTP_USER=usr_webXXX_1
FTP_PASSWORD=BITTE_ERSETZEN

# Bei SFTP wird der beim ersten Verbindungsaufbau gelernte SSH-Schluessel hier gespeichert.
SFTP_KNOWN_HOSTS=/etc/sennelager-range-known-hosts
